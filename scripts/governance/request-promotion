#!/usr/bin/env python3
import argparse, json, os, sys, uuid
from datetime import datetime, timezone
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from promotion_queue_lib import update_queue

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--repo-root',default='.')
    ap.add_argument('--request-json')
    a=ap.parse_args()
    root=os.path.abspath(a.repo_root)
    r=json.loads(a.request_json if a.request_json else sys.stdin.read())
    for k in ['learning_event_id','change_type','risk','relative_path','reason']:
        if k not in r: raise SystemExit('missing '+k)
    r['request_id']=r.get('request_id') or 'PROMO-REQ-'+uuid.uuid4().hex[:10]
    r['status']='REQUESTED'
    r['requested_at']=datetime.now(timezone.utc).isoformat()
    update_queue(root,r,'request-promotion')
    print(json.dumps(r,ensure_ascii=False))
if __name__=='__main__': main()
