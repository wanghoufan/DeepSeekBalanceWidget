#!/usr/bin/env python3
import argparse,json,os,sys,uuid
from datetime import datetime,timezone
sys.path.insert(0,os.path.dirname(os.path.abspath(__file__)))
from lock_utils import FileLock

def jsonl(p):
    if not os.path.exists(p): return []
    return [json.loads(x) for x in open(p,encoding='utf-8') if x.strip()]

def identity(root,did):
    p=os.path.join(root,'docs','runtime','TRUSTED_DISPATCH_IDENTITY.jsonl')
    for x in reversed(jsonl(p)):
        if x.get('dispatch_id')==did: return x
    raise SystemExit('DENY: trusted dispatch identity missing')

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--repo-root',default='.')
    ap.add_argument('--dispatch-id',required=True)
    ap.add_argument('--source-pattern-id',required=True)
    ap.add_argument('--target-pattern-id',required=True)
    ap.add_argument('--reason',required=True)
    a=ap.parse_args(); root=os.path.abspath(a.repo_root)
    ident=identity(root,a.dispatch_id)
    if ident.get('actual_role')!='experience-recorder':
        raise SystemExit('DENY: only Experience Recorder may propose candidate merge')
    rec={
      'merge_request_id':'PMR-'+uuid.uuid4().hex[:12],
      'source_pattern_id':a.source_pattern_id,
      'target_pattern_id':a.target_pattern_id,
      'reason':a.reason,
      'requester_dispatch_id':a.dispatch_id,
      'requester_worker_id':ident.get('worker_id'),
      'status':'REQUESTED',
      'requested_at':datetime.now(timezone.utc).isoformat()
    }
    p=os.path.join(root,'docs','learning','PATTERN_MERGE_REQUESTS.jsonl')
    with FileLock(p+'.lock','pattern-merge-request',timeout=5,stale_after=15):
        with open(p,'a',encoding='utf-8') as f:
            f.write(json.dumps(rec,ensure_ascii=False,separators=(',',':'))+'\n')
            f.flush(); os.fsync(f.fileno())
    print(json.dumps(rec,ensure_ascii=False))
if __name__=='__main__': main()
