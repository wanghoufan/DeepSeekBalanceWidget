<Window x:Class="DeepSeekBalanceWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="16">
    <TextBlock Text="API Key（DPAPI 加密存储）" Margin="0,0,0,4"/>
    <PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,12"/>

    <TextBlock Text="刷新间隔（秒，5-3600）" Margin="0,0,0,4"/>
    <TextBox x:Name="IntervalBox" Margin="0,0,0,12"/>

    <TextBlock Text="低余额阈值（元）" Margin="0,0,0,4"/>
    <TextBox x:Name="ThresholdBox" Margin="0,0,0,12"/>

    <TextBlock Text="异常下降百分比（%）" Margin="0,0,0,4"/>
    <TextBox x:Name="ChangePercentBox" Margin="0,0,0,12"/>

    <TextBlock Text="高峰时段（预计，官方策略待通知，北京时间）" Margin="0,0,0,4"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
      <TextBox x:Name="Peak1StartBox" Width="40" Text="9"/>
      <TextBlock Text=" 至 " VerticalAlignment="Center"/>
      <TextBox x:Name="Peak1EndBox" Width="40" Text="12"/>
      <TextBlock Text="   &amp;   " VerticalAlignment="Center"/>
      <TextBox x:Name="Peak2StartBox" Width="40" Text="14"/>
      <TextBlock Text=" 至 " VerticalAlignment="Center"/>
      <TextBox x:Name="Peak2EndBox" Width="40" Text="18"/>
      <TextBlock Text=" 时" VerticalAlignment="Center" FontSize="10" Foreground="#888888"/>
    </StackPanel>
    <CheckBox x:Name="ShowPeakCheck" Content="显示高峰指示" Margin="0,0,0,12"/>

    <TextBlock Text="币种" Margin="0,0,0,4"/>
    <ComboBox x:Name="CurrencyBox" Margin="0,0,0,12">
      <ComboBoxItem Content="CNY"/>
      <ComboBoxItem Content="USD"/>
    </ComboBox>

    <CheckBox x:Name="TopmostCheck" Content="始终置顶" Margin="0,0,0,8"/>
    <CheckBox x:Name="EdgeAutoHideCheck" Content="贴边自动隐藏" Margin="0,0,0,8"
              ToolTip="拖到桌面边缘后自动收起，鼠标移回窄边时展开"/>
    <CheckBox x:Name="MiniModeCheck" Content="迷你胶囊模式（默认收起）" Margin="0,0,0,8"/>
    <CheckBox x:Name="EnableCodexCheck" Content="开启 ChatGPT Plus 额度监测" Margin="0,0,0,8"
              ToolTip="通过本机已登录的 Codex 读取 ChatGPT Plus 用量窗口"/>
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="额度文字大小（10-24）" Margin="0,0,0,4"/>
        <TextBox x:Name="CodexFontSizeBox"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="额度文字样式" Margin="0,0,0,4"/>
        <ComboBox x:Name="CodexFontStyleBox">
          <ComboBoxItem Content="原版（半粗体）" Tag="DeepSeek"/>
          <ComboBoxItem Content="常规" Tag="Regular"/>
          <ComboBoxItem Content="粗体" Tag="Bold"/>
        </ComboBox>
      </StackPanel>
    </Grid>
    <CheckBox x:Name="MockCheck" Content="使用 Mock 数据（离线）" Margin="0,0,0,8"/>
    <CheckBox x:Name="AutoStartCheck" Content="开机自启" Margin="0,0,0,8"/>

    <TextBlock Text="默认位置" Margin="0,0,0,4"/>
    <ComboBox x:Name="CornerBox" Margin="0,0,0,12">
      <ComboBoxItem Content="记忆上次位置" Tag="Remember"/>
      <ComboBoxItem Content="右下角" Tag="BottomRight"/>
      <ComboBoxItem Content="左下角" Tag="BottomLeft"/>
    </ComboBox>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="清除 Key" Margin="0,0,8,0" Click="ClearKey_Click"/>
      <Button Content="保存" Width="80" IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
