<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <sys:String x:Key="ThemeModeMarker" xmlns:sys="clr-namespace:System;assembly=mscorlib">Light</sys:String>
  <LinearGradientBrush x:Key="CapsuleBgBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F8FAFF" Offset="0"/>
    <GradientStop Color="#E8EEF8" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CapsuleBorderBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#B9C6D8" Offset="0"/>
    <GradientStop Color="#D6DEE9" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="CapsuleTextBrush" Color="#1F2937"/>
  <SolidColorBrush x:Key="CapsuleEmphasisTextBrush" Color="#1F4E85"/>
  <SolidColorBrush x:Key="CapsuleSubtleTextBrush" Color="#536273"/>
  <SolidColorBrush x:Key="CapsuleMutedTextBrush" Color="#718096"/>
  <SolidColorBrush x:Key="CapsuleControlBrush" Color="#26000000"/>
  <SolidColorBrush x:Key="CapsuleHoverBrush" Color="#33000000"/>
  <SolidColorBrush x:Key="CapsulePressedBrush" Color="#50000000"/>
  <SolidColorBrush x:Key="CapsuleTrackBrush" Color="#26000000"/>
  <SolidColorBrush x:Key="CapsuleSuccessBrush" Color="#258A4A"/>
  <Color x:Key="CapsuleShadowColor">#6A7280</Color>
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F6F8"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PrimaryBrush" Color="#1677FF"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4096FF"/>
  <SolidColorBrush x:Key="PrimaryActiveBrush" Color="#0958D9"/>
  <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E6F4FF"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#D9D9D9"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="TextMainBrush" Color="#1F1F1F"/>
  <SolidColorBrush x:Key="TextSecondBrush" Color="#8C8C8C"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#888888"/>
  <SolidColorBrush x:Key="DisabledBrush" Color="#99C7FF"/>
  <SolidColorBrush x:Key="PeakWarningBrush" Color="#E86656"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#D94B4B"/>
