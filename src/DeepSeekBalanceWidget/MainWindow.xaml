<Window x:Class="DeepSeekBalanceWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Width="306" SizeToContent="Height"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        LocationChanged="Window_LocationChanged">
  <Window.Resources>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F0262E3B" Offset="0"/>
      <GradientStop Color="#F0151A21" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#66FFFFFF" Offset="0"/>
      <GradientStop Color="#22FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2"
                      Direction="270" Opacity="0.45" Color="#000000"/>
    <Style x:Key="TitleBtn" TargetType="Button">
      <Setter Property="Width" Value="23"/>
      <Setter Property="Height" Value="23"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
      <Setter Property="Foreground" Value="#F2FFFFFF"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="1,0,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#30FFFFFF"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
            <Setter Property="Background" Value="#50FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="立即刷新" Click="RefreshMenu_Click"/>
      <MenuItem Header="设置..." Click="SettingsMenu_Click"/>
      <MenuItem Header="恢复默认位置" Click="ResetPositionMenu_Click"/>
      <Separator/>
      <MenuItem Header="退出" Click="ExitMenu_Click"/>
    </ContextMenu>
  </Window.ContextMenu>

  <Grid>
    <!-- 完整卡片（默认形态） -->
    <Border x:Name="Card" CornerRadius="14" Padding="14,12,14,13" Margin="10"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
            Effect="{StaticResource CardShadow}">
      <StackPanel>
        <!-- 标题行：账户状态与窗口操作分区，高峰信息移至底部 -->
        <Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock x:Name="StatusDot" Text="●" Foreground="#4CC94C" FontSize="9"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusLabel" Text="正常" Foreground="#F0F7FF" FontSize="11"
                       FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <Border HorizontalAlignment="Right" CornerRadius="7" Padding="2"
                  Background="#16FFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="MiniBtn" Style="{StaticResource TitleBtn}" Content="&#xE921;"
                      ToolTip="切换迷你模式" Click="MiniBtn_Click"/>
              <Button x:Name="PinBtn" Style="{StaticResource TitleBtn}" Content="&#xE718;"
                      ToolTip="置顶开关" Click="PinBtn_Click"/>
              <Button x:Name="TrayBtn" Style="{StaticResource TitleBtn}" Content="&#xE70D;"
                      ToolTip="隐藏到托盘" Click="TrayBtn_Click"/>
              <Button x:Name="CloseBtn" Style="{StaticResource TitleBtn}" Content="&#xE8BB;"
                      Margin="5,0,0,0" ToolTip="退出" Click="CloseBtn_Click"/>
            </StackPanel>
          </Border>
        </Grid>

        <TextBlock x:Name="BalanceText" Text="¥ --.--" FontSize="26"
                   FontWeight="SemiBold" Foreground="#F0F7FF" FontFamily="Segoe UI"
                   Margin="0,10,0,2"/>
        <TextBlock x:Name="ChangeText" Text="--" FontSize="12" Foreground="#D0D0D0"
                   Margin="0,0,0,6"/>
        <TextBlock x:Name="BreakdownText" Text="充值 --.--"
                   FontSize="11" Foreground="#C8C8C8" Margin="0,0,0,5"/>
        <StackPanel x:Name="CodexPanel">
          <Border Height="1" Background="#20FFFFFF" Margin="0,2,0,7"/>
          <StackPanel x:Name="CodexAccount1Panel">
            <TextBlock x:Name="CodexAccount1Name" Text="ChatGPT 账号"
                       FontSize="11" Foreground="#DDEBFF" FontFamily="Segoe UI"
                       TextWrapping="Wrap" Margin="0,0,0,2"/>
            <TextBlock x:Name="CodexUsageText" Text="正在读取额度..."
                     FontSize="14" FontWeight="SemiBold" Foreground="#BFDFFF"
                     FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,0,0,3"/>
            <TextBlock x:Name="CodexResetText" Text="--"
                     FontSize="12" FontWeight="SemiBold" Foreground="#8F99A6"
                     FontFamily="Segoe UI" TextWrapping="Wrap"/>
          </StackPanel>
          <Border x:Name="CodexAccountDivider" Height="1" Background="#18FFFFFF" Margin="0,7,0,7"/>
          <StackPanel x:Name="CodexAccount2Panel">
            <TextBlock x:Name="CodexAccount2Name" Text="ChatGPT 账号"
                       FontSize="11" Foreground="#DDEBFF" FontFamily="Segoe UI"
                       TextWrapping="Wrap" Margin="0,0,0,2"/>
            <TextBlock x:Name="CodexUsageText2" Text="正在读取额度..."
                       FontSize="14" FontWeight="SemiBold" Foreground="#BFDFFF"
                       FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,0,0,3"/>
            <TextBlock x:Name="CodexResetText2" Text="--"
                       FontSize="12" FontWeight="SemiBold" Foreground="#8F99A6"
                       FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,0,0,7"/>
          </StackPanel>
        </StackPanel>
        <Grid>
          <TextBlock x:Name="RefreshTimeText" Text="上次刷新：--" FontSize="9"
                     Foreground="#8F99A6" VerticalAlignment="Center"/>
          <Border x:Name="PeakText" HorizontalAlignment="Right" Background="Transparent">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="PeakDot" Text="●" Foreground="#78D79A" FontSize="7"
                         VerticalAlignment="Center"/>
              <TextBlock x:Name="PeakLabel" Text="非高峰时段" Foreground="#AEB8C4" FontSize="9"
                         Margin="4,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </Border>

    <!-- 迷你胶囊（可选形态） -->
    <Border x:Name="MiniCard" Visibility="Collapsed" CornerRadius="16"
            Padding="14,8" Margin="10" Cursor="Hand"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
            Effect="{StaticResource CardShadow}"
            ToolTip="拖动调整位置，双击展开"
            MouseLeftButtonDown="MiniCard_MouseLeftButtonDown">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="MiniBalanceText" Text="¥ --.--" FontSize="15"
                   FontWeight="SemiBold" Foreground="#F0F7FF" FontFamily="Segoe UI"/>
        <TextBlock x:Name="MiniChangeText" Text="--" FontSize="12" Foreground="#D0D0D0"
                   Margin="8,0,0,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="MiniCodexText" Text="M --  W --" FontSize="13"
                   FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="#BFDFFF"
                   Margin="8,0,0,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="MiniPeakDot" Text="●" FontSize="9" Margin="8,0,0,0"
                   VerticalAlignment="Center" Foreground="#4CC94C"/>
        <Button x:Name="MiniEdgeAutoHideBtn" Style="{StaticResource TitleBtn}" Content="&#xE72E;"
                Margin="7,0,0,0" ToolTip="开启贴边隐藏" Click="MiniEdgeAutoHideBtn_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
