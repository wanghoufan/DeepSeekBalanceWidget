<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DeepSeekBalanceWidget.MainWindow"
        Title="DeepSeek 余额监控"
        Width="390" MinWidth="350" Height="410"
        CanResize="False"
        TransparencyLevelHint="AcrylicBlur"
        Background="#171B22">
  <Border Margin="14" Padding="20" CornerRadius="14" Background="#202631" BorderBrush="#3B4658" BorderThickness="1">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="StatusDot" Text="●" Foreground="#4CC94C" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusText" Text="准备就绪" Foreground="#E8F4FF" FontWeight="SemiBold" />
        </StackPanel>
        <Button Grid.Column="1" Content="刷新" Click="Refresh_Click" Margin="8,0,0,0" />
        <Button Grid.Column="2" Content="设置" Click="Settings_Click" Margin="8,0,0,0" />
      </Grid>

      <StackPanel Grid.Row="1" Spacing="3">
        <TextBlock x:Name="BalanceText" Text="¥ --.--" FontSize="34" FontWeight="SemiBold" Foreground="#F0F7FF" />
        <TextBlock x:Name="ChangeText" Text="等待首次刷新" Foreground="#BBC5D1" />
        <TextBlock x:Name="BreakdownText" Text="充值 --.-- · 赠送 --.--" Foreground="#9DA9B8" FontSize="12" />
      </StackPanel>

      <Border Grid.Row="2" BorderBrush="#344052" BorderThickness="0,1,0,0" Padding="0,12,0,0">
        <StackPanel Spacing="5">
          <TextBlock Text="ChatGPT Plus 用量" Foreground="#DDEBFF" FontWeight="SemiBold" />
          <TextBlock x:Name="CodexText" Text="正在读取本机 Codex 用量…" TextWrapping="Wrap" Foreground="#BFDFFF" />
        </StackPanel>
      </Border>

      <TextBlock Grid.Row="3" x:Name="PeakText" Text="预计非高峰时段" Foreground="#78D79A" FontSize="12" />
      <TextBlock Grid.Row="4" x:Name="ErrorText" Foreground="#FFB347" TextWrapping="Wrap" VerticalAlignment="Center" />

      <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
        <TextBlock x:Name="RefreshTimeText" Text="上次刷新：--" Foreground="#8F99A6" FontSize="11" />
        <Button Grid.Column="1" Content="隐藏" Click="Exit_Click" />
      </Grid>
    </Grid>
  </Border>
</Window>
