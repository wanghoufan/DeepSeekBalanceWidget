<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DeepSeekBalanceWidget.SettingsWindow"
        Title="DeepSeek 余额监控设置"
        Width="440" Height="620" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer>
    <StackPanel Margin="22" Spacing="9">
      <TextBlock Text="API Key（存储在 macOS 登录钥匙串）" />
      <TextBox x:Name="ApiKeyBox" Watermark="留空会保留已保存的 Key" PasswordChar="●" />

      <TextBlock Text="刷新间隔（秒，5–3600）" />
      <TextBox x:Name="IntervalBox" />
      <TextBlock Text="低余额阈值" />
      <TextBox x:Name="ThresholdBox" />
      <TextBlock Text="异常下降百分比（0–100）" />
      <TextBox x:Name="ChangePercentBox" />

      <TextBlock Text="币种" />
      <ComboBox x:Name="CurrencyBox">
        <ComboBoxItem Content="CNY" />
        <ComboBoxItem Content="USD" />
      </ComboBox>

      <CheckBox x:Name="TopmostCheck" Content="始终置顶" />
      <CheckBox x:Name="EnableCodexCheck" Content="开启 ChatGPT Plus 额度监测（读取本机 CC Switch 账号）" />
      <CheckBox x:Name="ShowPeakCheck" Content="显示预计高峰时段" />
      <CheckBox x:Name="MockCheck" Content="使用 Mock 数据（离线测试）" />
      <CheckBox x:Name="AutoStartCheck" Content="登录时自动启动" />

      <TextBlock x:Name="ErrorText" Foreground="#D94B4B" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
        <Button Content="清除 Key" Click="ClearKey_Click" />
        <Button Content="取消" Click="Cancel_Click" />
        <Button Content="保存" IsDefault="True" Click="Save_Click" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
