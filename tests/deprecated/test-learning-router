#!/usr/bin/env python3
import json, os, subprocess, sys, tempfile
W=os.path.abspath(os.path.join(os.path.dirname(__file__),'..','..','scripts','governance','write-learning-event'))
R=os.path.abspath(os.path.join(os.path.dirname(__file__),'..','..','scripts','governance','learning-router'))
with tempfile.TemporaryDirectory() as d:
    ids=[]
    for _ in range(3):
        e={'project_id':'P','stage_id':'S','trigger':'USER_CORRECTION','symptom':'TM stopped','root_cause':'prompt','current_fix':'resume',
           'impact':'HIGH','candidate_type':'GUARD_RULE','reusable':True,'learning_pattern_id':'TM_CONTINUE'}
        w=subprocess.run([sys.executable,'-S',W,'--repo-root',d],input=json.dumps(e),text=True,capture_output=True); assert w.returncode==0,w.stderr
        ids.append(json.loads(w.stdout)['event_id'])
    out=[]
    for eid in ids:
        r=subprocess.run([sys.executable,'-S',R,'--repo-root',d,'--event-id',eid,'--persist'],text=True,capture_output=True); assert r.returncode==0,r.stderr
        out.append(json.loads(r.stdout))
    assert out[0]['routing_class']=='PROJECT_PATCH' and out[0]['recurrence_count']==1
    assert out[1]['routing_class']=='GUARD_RULE' and out[1]['recurrence_count']==2
    assert out[2]['rule_escalation']=='GUARD_CONTRACT_TEST_TOOL_CONSTRAINT'
print('PASS test-learning-router')
