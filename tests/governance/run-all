#!/usr/bin/env python3
import os, signal, subprocess, sys, tempfile, time

HERE=os.path.dirname(os.path.abspath(__file__))
OVERALL_TIMEOUT=420
DEFAULT_PER_TEST_TIMEOUT=75
TIMEOUT_OVERRIDES={
  'test-full-cross-project-learning-loop':120,
  'test-promotion-queue-concurrency':90
}

def active_tests():
    names=[]
    for name in os.listdir(HERE):
        path=os.path.join(HERE,name)
        if name.startswith('test-') and os.path.isfile(path):
            names.append(name)
    return sorted(names)

def kill_tree(proc):
    if proc.poll() is not None: return
    try:
        if os.name=='nt':
            subprocess.run(['taskkill','/PID',str(proc.pid),'/T','/F'],
                           stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=5)
        else:
            os.killpg(proc.pid,signal.SIGKILL)
    except Exception:
        try: proc.kill()
        except Exception: pass
    try: proc.wait(timeout=3)
    except Exception: pass

def run_one(name,timeout):
    path=os.path.join(HERE,name)
    out=tempfile.NamedTemporaryFile(prefix=name+'-out-',delete=False); out.close()
    err=tempfile.NamedTemporaryFile(prefix=name+'-err-',delete=False); err.close()
    kwargs={'start_new_session':True} if os.name!='nt' else {'creationflags':getattr(subprocess,'CREATE_NEW_PROCESS_GROUP',0)}
    with open(out.name,'wb') as of, open(err.name,'wb') as ef:
        proc=subprocess.Popen([sys.executable,'-S',path],stdout=of,stderr=ef,**kwargs)
        try:
            rc=proc.wait(timeout=timeout); status='PASS' if rc==0 else 'FAIL'
        except subprocess.TimeoutExpired:
            kill_tree(proc); rc=124; status='TIMEOUT'
    stdout=open(out.name,encoding='utf-8',errors='replace').read()
    stderr=open(err.name,encoding='utf-8',errors='replace').read()
    for p in (out.name,err.name):
        try: os.unlink(p)
        except Exception: pass
    return status,rc,stdout,stderr

def main():
    tests=active_tests()
    if not tests:
        print('FAIL no active tests discovered',flush=True); return 2
    print('DISCOVERED '+str(len(tests))+' ACTIVE TESTS: '+', '.join(tests),flush=True)
    started=time.monotonic(); failed=[]
    for name in tests:
        if time.monotonic()-started>OVERALL_TIMEOUT:
            print(f'TIMEOUT overall after {OVERALL_TIMEOUT}s',flush=True); return 124
        timeout=TIMEOUT_OVERRIDES.get(name,DEFAULT_PER_TEST_TIMEOUT)
        print(f'RUN {name}',flush=True)
        status,rc,out,err=run_one(name,timeout)
        if out: print(out,end='' if out.endswith('\n') else '\n',flush=True)
        if err: print(err,end='' if err.endswith('\n') else '\n',file=sys.stderr,flush=True)
        if status=='PASS':
            print(f'PASS {name}',flush=True)
        elif status=='TIMEOUT':
            print(f'TIMEOUT {name} after {timeout}s',flush=True); failed.append((name,'TIMEOUT'))
        else:
            print(f'FAIL {name} exit={rc}',flush=True); failed.append((name,rc))
    if failed:
        print('FAIL ALL: '+repr(failed),flush=True); return 1
    print(f'PASS ALL ACTIVE GOVERNANCE TESTS ({len(tests)}/{len(tests)})',flush=True)
    return 0
if __name__=='__main__': raise SystemExit(main())
