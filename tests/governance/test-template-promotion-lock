#!/usr/bin/env python3
import hashlib, json, os, shutil, subprocess, sys, tempfile
from _testlib import trusted_template_sync
BASE=os.path.abspath(os.path.join(os.path.dirname(__file__),'..','..'))

def h(p): return hashlib.sha256(open(p,'rb').read()).hexdigest()
def append(p,o):
    os.makedirs(os.path.dirname(p),exist_ok=True)
    with open(p,'a',encoding='utf-8') as f: f.write(json.dumps(o)+'\n')

with tempfile.TemporaryDirectory() as d:
    tr=os.path.join(d,'template')
    p1=os.path.join(d,'project1'); p2=os.path.join(d,'project2')
    shutil.copytree(BASE,tr,ignore=shutil.ignore_patterns('__pycache__','*.pyc','*.lock'))
    TS=os.path.join(tr,'scripts','governance','template-sync')
    BS=os.path.join(tr,'scripts','governance','bootstrap-project')
    trusted_template_sync(tr,initialize=True,delivery_version='TEST',script_path=TS)
    for pr,pid in [(p1,'P1'),(p2,'P2')]:
        subprocess.run([sys.executable,'-S',BS,'--template-root',tr,'--project-root',pr,'--project-id',pid,'--repo-id','R'],
                       check=True,capture_output=True,text=True,timeout=30)
        ident=os.path.join(pr,'docs','runtime','TRUSTED_DISPATCH_IDENTITY.jsonl')
        append(ident,{'dispatch_id':'DQA','worker_id':'WQA','task_id':'T','actual_role':'qa'})
        append(ident,{'dispatch_id':'DER','worker_id':'WER','task_id':'T','actual_role':'experience-recorder'})

    procs=[]
    for idx,pr in [(1,p1),(2,p2)]:
        content=os.path.join(d,f'c{idx}.md'); open(content,'w').write(f'# c{idx}\n')
        rel=f'docs/checklists/concurrent-{idx}.md'
        vr={'what_test':'promotion-validation','target':rel,'target_hash':h(content),'target_version':'1','result':'PASS'}
        rv=subprocess.run(
          [sys.executable,'-S',os.path.join(pr,'scripts','governance','write-validation-receipt'),
           '--repo-root',pr,'--dispatch-id','DQA','--scope','PROMOTION_VALIDATION'],
          input=json.dumps(vr),text=True,capture_output=True,timeout=15
        )
        assert rv.returncode==0,rv.stderr
        rid=json.loads(rv.stdout)['validation_receipt_id']
        req={'learning_event_id':f'E{idx}','change_type':'CHECKLIST','risk':'LOW',
             'relative_path':rel,'content_file':content,'validation_receipt_id':rid}
        rp=os.path.join(d,f'req{idx}.json'); json.dump(req,open(rp,'w'))
        env=dict(os.environ)
        env['ORCA_GOVERNANCE_INTERNAL_SECRET']='template-promotion-lock-test-secret-abcdefghijklmnopqrstuvwxyz-123456'
        procs.append(subprocess.Popen(
          [sys.executable,'-S',os.path.join(pr,'scripts','governance','promotion-gateway'),
           '--request',rp,'--project-root',pr,'--template-root',tr,'--dispatch-id','DER'],
          stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,env=env
        ))

    results=[]
    for p in procs:
        out,err=p.communicate(timeout=40)
        results.append((p.returncode,out,err))

    # Shared Template Promotion Lock serializes both. The winner bumps the template;
    # the second project then becomes stale and must be denied instead of overwriting.
    successes=[x for x in results if x[0]==0]
    failures=[x for x in results if x[0]!=0]
    assert len(successes)==1,results
    assert len(failures)==1,results
    assert 'stale' in failures[0][2].lower(),failures[0]

    # Template Manifest remains internally consistent after the serialized transaction.
    m=json.load(open(os.path.join(tr,'docs','governance','TEMPLATE_MANIFEST.json')))
    by={x['path']:x for x in m['files']}
    present=[r for r in ['docs/checklists/concurrent-1.md','docs/checklists/concurrent-2.md'] if r in by]
    assert len(present)==1

print('PASS test-template-promotion-lock')
