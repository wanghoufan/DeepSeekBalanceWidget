#!/usr/bin/env python3
import json, os, shutil, subprocess, sys, tempfile
from _testlib import trusted_template_sync
from datetime import datetime, timezone, timedelta
BASE=os.path.abspath(os.path.join(os.path.dirname(__file__),'..','..'))

with tempfile.TemporaryDirectory() as d:
    tr=os.path.join(d,'template'); pr=os.path.join(d,'project')
    shutil.copytree(BASE,tr,ignore=shutil.ignore_patterns('__pycache__','*.pyc','*.lock'))
    TS=os.path.join(tr,'scripts','governance','template-sync'); BS=os.path.join(tr,'scripts','governance','bootstrap-project'); SG=os.path.join(tr,'scripts','governance','stale-template-guard')
    trusted_template_sync(tr,initialize=True,delivery_version='TEST',script_path=TS)
    subprocess.run([sys.executable,'-S',BS,'--template-root',tr,'--project-root',pr,'--project-id','P','--repo-id','R'],check=True,capture_output=True,text=True)
    applied=json.load(open(os.path.join(pr,'docs','governance','PROJECT_GOVERNANCE_APPLIED.yaml')))
    open(os.path.join(tr,'new.md'),'w').write('new')
    trusted_template_sync(tr,promotion_id='P2',delivery_version='TEST',script_path=TS)

    now=datetime.now(timezone.utc)
    receipt={
      'record_type':'ISSUED','approval_id':'A-PIN','project_id':'P',
      'approved_template_version':applied['current_applied_template_version'],
      'approved_manifest_hash':applied['current_applied_manifest_hash'],
      'scope':'TEMPLATE_PIN','one_shot':True,'trusted_user_origin':True,
      'issued_at':now.isoformat(),'expires_at':(now+timedelta(hours=1)).isoformat()
    }
    with open(os.path.join(pr,'docs','runtime','TRUSTED_USER_APPROVAL_RECEIPTS.jsonl'),'a') as f:
        f.write(json.dumps(receipt)+'\n')
    r=subprocess.run([sys.executable,'-S',SG,'--project-root',pr,'--template-root',tr,'--pin-approval-id','A-PIN'],capture_output=True,text=True)
    assert r.returncode==0,r.stdout+r.stderr
    assert 'PINNED_OLD_TEMPLATE' in r.stdout
    # Subsequent checks use validated pin state; receipt cannot be replayed for another pin action.
    r2=subprocess.run([sys.executable,'-S',SG,'--project-root',pr,'--template-root',tr],capture_output=True,text=True)
    assert r2.returncode==0 and 'PINNED_OLD_TEMPLATE' in r2.stdout
print('PASS test-old-template-pin-receipt')
