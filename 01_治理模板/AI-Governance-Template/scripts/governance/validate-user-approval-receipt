#!/usr/bin/env python3
import argparse, json, os, sys
from datetime import datetime, timezone
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from lock_utils import FileLock

def jsonl(p):
    if not os.path.exists(p): return []
    return [json.loads(x) for x in open(p,encoding='utf-8') if x.strip()]

def validate(root,approval_id,scope,project_id=None,template_version=None,manifest_hash=None,consume=False):
    p=os.path.join(root,'docs','runtime','TRUSTED_USER_APPROVAL_RECEIPTS.jsonl')
    rs=[x for x in jsonl(p) if x.get('approval_id')==approval_id]
    issued=next((x for x in rs if x.get('record_type','ISSUED') in {'ISSUED','BOOTSTRAP_APPROVAL_ISSUED'}),None)
    if not issued: raise SystemExit('DENY: approval receipt missing')
    if any(x.get('record_type')=='CONSUMED' for x in rs): raise SystemExit('DENY: approval receipt replay')
    if issued.get('trusted_user_origin') is not True: raise SystemExit('DENY: untrusted user origin')
    if issued.get('scope')!=scope: raise SystemExit('DENY: scope mismatch')
    if project_id and issued.get('project_id')!=project_id: raise SystemExit('DENY: project mismatch')
    if template_version and issued.get('approved_template_version')!=template_version: raise SystemExit('DENY: template version mismatch')
    if manifest_hash and issued.get('approved_manifest_hash')!=manifest_hash: raise SystemExit('DENY: manifest hash mismatch')
    if issued.get('one_shot') is not True: raise SystemExit('DENY: one_shot required')
    exp=issued.get('expires_at')
    if exp and datetime.fromisoformat(exp)<datetime.now(timezone.utc): raise SystemExit('DENY: approval expired')
    if consume:
        with FileLock(p+'.lock','approval-consume',timeout=5,stale_after=15):
            # re-read under lock for replay race
            nowrs=[x for x in jsonl(p) if x.get('approval_id')==approval_id]
            if any(x.get('record_type')=='CONSUMED' for x in nowrs): raise SystemExit('DENY: approval receipt replay')
            with open(p,'a',encoding='utf-8') as f:
                f.write(json.dumps({'record_type':'CONSUMED','approval_id':approval_id,'used_at':datetime.now(timezone.utc).isoformat()},ensure_ascii=False)+'\n')
                f.flush(); os.fsync(f.fileno())
    return issued

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--repo-root',default='.')
    ap.add_argument('--approval-id',required=True)
    ap.add_argument('--scope',required=True)
    ap.add_argument('--project-id')
    ap.add_argument('--template-version')
    ap.add_argument('--manifest-hash')
    ap.add_argument('--bootstrap-binding-json')
    ap.add_argument('--consume',action='store_true')
    a=ap.parse_args()
    out=validate(os.path.abspath(a.repo_root),a.approval_id,a.scope,a.project_id,a.template_version,a.manifest_hash,a.consume)
    if a.bootstrap_binding_json:
        expected=json.loads(a.bootstrap_binding_json)
        actual=out.get('bootstrap_binding') or {}
        for key,value in expected.items():
            if actual.get(key)!=value:
                raise SystemExit('DENY: bootstrap approval binding mismatch: '+key)
    print(json.dumps({'validation':'PASS','approval':out},ensure_ascii=False))
if __name__=='__main__': main()
