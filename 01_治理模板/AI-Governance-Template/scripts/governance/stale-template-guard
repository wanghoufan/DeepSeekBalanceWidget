#!/usr/bin/env python3
import argparse, hashlib, json, os, subprocess, sys

def h(p):
    x=hashlib.sha256()
    with open(p,'rb') as f:
        for c in iter(lambda:f.read(65536),b''): x.update(c)
    return x.hexdigest()

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--project-root',required=True)
    ap.add_argument('--template-root',required=True)
    ap.add_argument('--pin-approval-id')
    a=ap.parse_args()
    pr=os.path.abspath(a.project_root); tr=os.path.abspath(a.template_root)
    gd=os.path.join(pr,'docs','governance')
    apath=os.path.join(gd,'PROJECT_GOVERNANCE_APPLIED.yaml')
    opath=os.path.join(gd,'PROJECT_GOVERNANCE_ORIGIN.yaml')
    snapshot=os.path.join(gd,'PROJECT_GOVERNANCE_APPLIED_MANIFEST.json')
    mp=os.path.join(tr,'docs','governance','TEMPLATE_MANIFEST.json')
    vp=os.path.join(tr,'docs','governance','TEMPLATE_VERSION.yaml')

    for p in (apath,opath,snapshot,mp,vp):
        if not os.path.exists(p):
            print(json.dumps({'template_guard':'FAIL','status':'MISSING_GOVERNANCE_FILE','path':p},ensure_ascii=False))
            sys.exit(7)

    applied=json.load(open(apath,encoding='utf-8'))
    origin=json.load(open(opath,encoding='utf-8'))
    manifest=json.load(open(mp,encoding='utf-8'))
    version=json.load(open(vp,encoding='utf-8'))

    # Applied manifest snapshot is part of the trusted current-project state.
    snap_hash=h(snapshot)
    if snap_hash!=applied.get('current_applied_manifest_hash'):
        print(json.dumps({'template_guard':'FAIL','status':'APPLIED_MANIFEST_HASH_DRIFT'},ensure_ascii=False))
        sys.exit(8)
    snap=json.load(open(snapshot,encoding='utf-8'))
    if snap.get('template_fingerprint')!=applied.get('current_applied_fingerprint'):
        print(json.dumps({'template_guard':'FAIL','status':'APPLIED_MANIFEST_FINGERPRINT_DRIFT'},ensure_ascii=False))
        sys.exit(8)

    current_hash=h(mp)
    is_current=(
      applied.get('current_applied_template_version')==version.get('template_version')
      and applied.get('current_applied_fingerprint')==manifest.get('template_fingerprint')
      and applied.get('current_applied_manifest_hash')==current_hash
    )
    if is_current:
        print(json.dumps({
          'template_guard':'PASS','status':'CURRENT',
          'applied_version':applied.get('current_applied_template_version')
        },ensure_ascii=False))
        return

    pin=applied.get('pin') or {}
    if pin.get('status')=='VALIDATED' and \
       pin.get('approved_template_version')==applied.get('current_applied_template_version') and \
       pin.get('approved_manifest_hash')==applied.get('current_applied_manifest_hash'):
        print(json.dumps({
          'template_guard':'PASS','status':'PINNED_OLD_TEMPLATE',
          'approval_id':pin.get('approval_id')
        },ensure_ascii=False))
        return

    if not a.pin_approval_id:
        print(json.dumps({
          'template_guard':'FAIL','status':'STALE_TEMPLATE',
          'applied_version':applied.get('current_applied_template_version'),
          'current_template_version':version.get('template_version')
        },ensure_ascii=False))
        sys.exit(5)

    validator=os.path.join(os.path.dirname(os.path.abspath(__file__)),'validate-user-approval-receipt')
    cmd=[sys.executable,'-S',validator,'--repo-root',pr,'--approval-id',a.pin_approval_id,
         '--scope','TEMPLATE_PIN','--project-id',origin.get('project_id'),
         '--template-version',applied.get('current_applied_template_version'),
         '--manifest-hash',applied.get('current_applied_manifest_hash'),'--consume']
    r=subprocess.run(cmd,capture_output=True,text=True,timeout=10)
    if r.returncode!=0:
        print(json.dumps({'template_guard':'FAIL','status':'PIN_RECEIPT_INVALID','detail':r.stderr.strip()},ensure_ascii=False))
        sys.exit(6)

    applied['pin']={
      'status':'VALIDATED',
      'approval_id':a.pin_approval_id,
      'approved_template_version':applied.get('current_applied_template_version'),
      'approved_manifest_hash':applied.get('current_applied_manifest_hash')
    }
    with open(apath,'w',encoding='utf-8') as f:
        json.dump(applied,f,ensure_ascii=False,indent=2); f.write('\n')
    print(json.dumps({'template_guard':'PASS','status':'PINNED_OLD_TEMPLATE','approval_id':a.pin_approval_id},ensure_ascii=False))

if __name__=='__main__': main()
