#!/usr/bin/env python3
import json, os, shutil, subprocess, sys, tempfile
BASE=os.path.abspath(os.path.join(os.path.dirname(__file__),'..','..'))
S=os.path.join(BASE,'scripts','governance','write-learning-event')

def seed(d):
    os.makedirs(os.path.join(d,'docs','learning'),exist_ok=True)
    shutil.copy2(
      os.path.join(BASE,'docs','learning','LEARNING_PATTERN_REGISTRY.yaml'),
      os.path.join(d,'docs','learning','LEARNING_PATTERN_REGISTRY.yaml')
    )

def run(d,claim):
    e={
      'project_id':'P','stage_id':'S','task_id':'T','dispatch_id':'D',
      'trigger':'USER_CORRECTION','symptom':'Task Manager stopped',
      'root_cause':'prompt-only discipline','current_fix':'resume',
      'impact':'HIGH','candidate_type':'GUARD_RULE','reusable':True,
      'learning_pattern_id':'TM_CONTINUE_UNTIL_TASK_OR_P0_DONE',
      'recurrence_count':claim
    }
    r=subprocess.run([sys.executable,'-S',S,'--repo-root',d],
                     input=json.dumps(e),text=True,capture_output=True,timeout=15)
    assert r.returncode==0,r.stderr
    return json.loads(r.stdout)

with tempfile.TemporaryDirectory() as d:
    seed(d)
    a,b,c=run(d,99),run(d,1),run(d,1)
    assert [a['recurrence_count'],b['recurrence_count'],c['recurrence_count']]==[1,2,3]
    assert [a['canonical_pattern_id'],b['canonical_pattern_id'],c['canonical_pattern_id']]==['TM_CONTINUATION']*3

    ledger=os.path.join(d,'docs','learning','LEARNING_EVENTS.jsonl')
    # stale lock recovery remains required
    json.dump({'pid':99999999,'owner':'dead','token':'x','created_epoch':0},open(ledger+'.lock','w'))
    z=run(d,1)
    assert z['recurrence_count']==4

print('PASS test-learning-capture')
