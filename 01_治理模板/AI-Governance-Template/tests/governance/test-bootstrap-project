#!/usr/bin/env python3
import json, os, subprocess, sys, tempfile
from _testlib import trusted_template_sync
B=os.path.abspath(os.path.join(os.path.dirname(__file__),'..','..'))
BS=os.path.join(B,'scripts','governance','bootstrap-project')
SG=os.path.join(B,'scripts','governance','stale-template-guard')
def dump(p,o):
    os.makedirs(os.path.dirname(p),exist_ok=True); json.dump(o,open(p,'w'))

with tempfile.TemporaryDirectory() as d:
    tr=os.path.join(d,'t'); pr=os.path.join(d,'p')
    os.makedirs(os.path.join(tr,'docs','governance')); os.makedirs(os.path.join(tr,'docs','learning'))
    os.makedirs(os.path.join(tr,'skills','demo'))
    open(os.path.join(tr,'AGENTS.md'),'w').write('# A\n')
    open(os.path.join(tr,'skills','demo','SKILL.md'),'w').write('# Demo\n')
    import hashlib
    hh=hashlib.sha256(open(os.path.join(tr,'skills','demo','SKILL.md'),'rb').read()).hexdigest()
    dump(os.path.join(tr,'docs','learning','SKILL_REGISTRY.yaml'),{'skills':[{
      'skill_id':'DEMO','status':'PRODUCTION','lifecycle_status':'INCLUDED_IN_TEMPLATE',
      'path':'skills/demo/SKILL.md','trigger':['demo'],'task_types':['QA'],
      'applicable_roles':['qa'],'required_capabilities':['read'],'required_tools':['read'],
      'write_scope':'NONE','shell_scope':'NONE','network_scope':'NONE','computer_use':False,
      'destructive':False,'risk_level':'LOW','validated_content_hash':hh,
      'validated_receipt_id':'VAL','source_project_id':'SRC','source_learning_event_id':'E',
      'first_promoted_at':'now','first_reused_project_id':None,'template_version':'x','last_validated':'now'
    }]})
    dump(os.path.join(tr,'docs','governance','TEMPLATE_VERSION.yaml'),{
      'schema_version':'4','authoritative':True,'governance_version':'V2.3.1',
      'template_version':'2.3.1-template.9','delivery_version':'TEST',
      'last_promotion_id':None,'updated_at':None
    })
    trusted_template_sync(tr,initialize=True,delivery_version='TEST',script_path=os.path.join(B,'scripts','governance','template-sync'))

    r=subprocess.run([sys.executable,'-S',BS,'--template-root',tr,'--project-root',pr,'--project-id','P','--repo-id','R'],
                     text=True,capture_output=True,timeout=30)
    assert r.returncode==0,r.stderr
    assert os.path.exists(os.path.join(pr,'skills','demo','SKILL.md'))
    assert os.path.exists(os.path.join(pr,'docs','governance','PROJECT_GOVERNANCE_APPLIED_MANIFEST.json'))
    assert subprocess.run([sys.executable,'-S',SG,'--project-root',pr,'--template-root',tr],
                          text=True,capture_output=True).returncode==0

    open(os.path.join(tr,'new.txt'),'w').write('n')
    trusted_template_sync(tr,promotion_id='PX',delivery_version='TEST',script_path=os.path.join(B,'scripts','governance','template-sync'))
    g=subprocess.run([sys.executable,'-S',SG,'--project-root',pr,'--template-root',tr],
                     text=True,capture_output=True)
    assert g.returncode!=0 and 'STALE_TEMPLATE' in g.stdout

print('PASS test-bootstrap-project')
