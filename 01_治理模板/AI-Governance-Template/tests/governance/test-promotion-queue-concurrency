#!/usr/bin/env python3
import json, os, subprocess, sys, tempfile
BASE=os.path.abspath(os.path.join(os.path.dirname(__file__),'..','..'))
REQ=os.path.join(BASE,'scripts','governance','request-promotion')

with tempfile.TemporaryDirectory() as d:
    ps=[]
    for i in range(20):
        req={
          'learning_event_id':f'E{i}','change_type':'CHECKLIST','risk':'LOW',
          'relative_path':f'docs/checklists/x{i}.md','reason':'concurrency-test'
        }
        ps.append(subprocess.Popen(
          [sys.executable,'-S',REQ,'--repo-root',d,'--request-json',json.dumps(req)],
          stdout=subprocess.DEVNULL,stderr=subprocess.PIPE,text=True
        ))
    for p in ps:
        _,err=p.communicate(timeout=10)
        assert p.returncode==0,err
    q=json.load(open(os.path.join(d,'docs','learning','PROMOTION_QUEUE.yaml'),encoding='utf-8'))
    ids={x.get('learning_event_id') for x in q.get('items',[])}
    assert len(ids)==20
print('PASS test-promotion-queue-concurrency')
